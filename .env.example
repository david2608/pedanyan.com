# Google Analytics 4.
# Measurement ID: Admin -> Data streams -> the web stream. Leaving it unset
# disables analytics entirely. Localhost is excluded even when it is set.
VITE_GA_MEASUREMENT_ID=

# Set to 1 to let a local dev server report anyway, tagged debug_mode so the
# hits land in GA's DebugView instead of the normal reports.
VITE_GA_DEBUG=
