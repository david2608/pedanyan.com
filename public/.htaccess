Options -MultiViews
RewriteEngine On

# Hashed Vite bundles can stay local for a year. Portfolio and character media
# revalidate weekly, so replacing an export does not leave visitors on stale
# artwork for long.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:avif|gif|jpe?g|mp4|png|svg|webm|webp)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(?:html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css application/javascript application/json image/svg+xml
</IfModule>

# Serve real files and folders without routing them through the React app.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send direct portfolio routes such as /am/projects/cloudchipr to the SPA.
RewriteRule ^ index.html [L]
